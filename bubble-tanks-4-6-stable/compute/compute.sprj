<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="Compute" type="compute" active="true">
			<shader type="cs" path="shaders\compute.glsl" entry="main" />
			<groupsize x="4" y="4" z="1" />
			<macros />
		</pass>
		<pass name="conway" type="compute" active="true">
			<shader type="cs" path="shaders\conwayCS.glsl" entry="main" />
			<groupsize x="20" y="20" z="1" />
			<macros />
		</pass>
		<pass name="generate_random" type="compute" active="true">
			<shader type="cs" path="shaders\generate_randomCS.glsl" entry="main" />
			<groupsize x="64" y="64" z="1" />
			<variables>
				<variable type="float" name="cell_size">
					<row>
						<value>0.5</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
		<pass name="Simple" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\ScreenQuadVS.glsl" entry="main" />
			<shader type="ps" path="shaders\ScreenQuadPS.glsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="ScreenQuad" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<macros />
		</pass>
	</pipeline>
	<objects>
		<object type="image" name="ComputeOutput" width="512" height="512" format="R32G32B32A32_FLOAT" />
		<object type="image" name="ddfs" width="128" height="128" format="R32G32B32A32_FLOAT" />
		<object type="image" name="inp" width="128" height="128" format="R8_INT" />
		<object type="texture" path="..\..\..\..\..\..\workspace-programming\shadered-env\SHADERed\SHADERed\rr.png" vflip="false" min_filter="Nearest" mag_filter="Nearest" wrap_s="Repeat" wrap_t="Repeat" />
		<object type="image" name="random_pixel" width="16" height="16" format="R32G32B32A32_FLOAT">
			<bind slot="0" name="generate_random" uav="1" />
			<bind slot="0" name="Simple" uav="0" />
		</object>
		<object type="buffer" name="cell_size" size="4" format="float" pausedpreview="false" />
	</objects>
	<cameras />
	<settings>
		<entry type="property" name="generate_random" item="pipe" />
		<entry type="file" name="generate_random" shader="cs" />
		<entry type="file" name="conway" shader="cs" />
		<entry type="camera" fp="false">
			<distance>4</distance>
			<pitch>28</pitch>
			<yaw>317</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="0" />
		<entry type="usealpha" val="false" />
	</settings>
	<plugindata />
</project>

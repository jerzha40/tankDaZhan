<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="compute" type="compute" active="true">
			<shader type="cs" path="shaders\computeCS.glsl" entry="main" />
			<groupsize x="1" y="1" z="1" />
			<variables>
				<variable type="float" name="roll">
					<row>
						<value>0</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
		<pass name="Simple" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\testt_SimpleVS.glsl" entry="main" />
			<shader type="ps" path="shaders\testt_SimplePS.glsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="sd" type="geometry">
					<type>ScreenQuad</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<macros />
		</pass>
	</pipeline>
	<objects>
		<object type="buffer" name="asd" size="0" format="float" pausedpreview="false">
			<bind slot="1" name="compute" />
		</object>
		<object type="image3d" name="sdf" width="1" height="1" depth="1" format="R32G32B32A32_FLOAT">
			<bind slot="0" name="compute" uav="1" />
			<bind slot="0" name="compute" uav="0" />
		</object>
	</objects>
	<cameras />
	<settings>
		<entry type="property" name="Simple" item="pipe" />
		<entry type="file" name="compute" shader="cs" />
		<entry type="file" name="Simple" shader="vs" />
		<entry type="file" name="Simple" shader="ps" />
		<entry type="pinned" name="roll" owner="compute" />
		<entry type="camera" fp="false">
			<distance>4</distance>
			<pitch>28</pitch>
			<yaw>317</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="0" />
		<entry type="usealpha" val="false" />
	</settings>
	<plugindata />
</project>
